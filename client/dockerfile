FROM node:20 AS build

WORKDIR /app

COPY package*.json ./
RUN npm install


COPY . .
RUN npm run build
 
# build done now we will use nginx to serve the static files generated by the build process.

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
